{
    "name": "nexusphp/assert",
    "description": "Chainable type-safety assertions library.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "John Paul E. Balandan, CPA",
            "email": "paulbalandan@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/NexusPHP/assert/issues",
        "source": "https://github.com/NexusPHP/assert"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.35",
        "nexusphp/cs-config": "^3.26"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nexus\\Assert\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Assert\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "cs:check": "php-cs-fixer check --verbose --ansi --diff",
        "cs:fix": "php-cs-fixer fix --verbose --ansi --diff"
    },
    "scripts-descriptions": {
        "cs:check": "Checks for coding style violations",
        "cs:fix": "Fixes coding style violations"
    }
}
