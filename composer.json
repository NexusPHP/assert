{
    "name": "nexusphp/assert",
    "description": "Chainable type-safety assertions library.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "John Paul E. Balandan, CPA",
            "email": "paulbalandan@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/NexusPHP/assert/issues",
        "source": "https://github.com/NexusPHP/assert"
    },
    "require": {
        "php": "^8.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nexus\\Assert\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Assert\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
