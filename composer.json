{
    "name": "nexusphp/assert",
    "description": "Chainable type-safety assertions library.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "John Paul E. Balandan, CPA",
            "email": "paulbalandan@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/NexusPHP/assert/issues",
        "source": "https://github.com/NexusPHP/assert"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.35",
        "nexusphp/cs-config": "^3.26",
        "nexusphp/tachycardia": "^2.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Nexus\\Assert\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Assert\\Tests\\": "tests/",
            "Nexus\\Assert\\Tools\\": "tools/src/"
        },
        "exclude-from-classmap": [
            "tests/data/**"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Nexus\\Assert\\Tools\\ComposerScripts::postUpdate"
        ],
        "cs:check": "php-cs-fixer check --verbose --ansi --diff",
        "cs:fix": "php-cs-fixer fix --verbose --ansi --diff",
        "phpstan:baseline": "phpstan analyse --verbose --ansi --generate-baseline=phpstan-baseline.php",
        "phpstan:check": "phpstan analyse --verbose --ansi",
        "test:all": [
            "@cs:check",
            "@phpstan:check",
            "@test:unit",
            "@test:stan"
        ],
        "test:stan": "phpunit --colors=always --group=static-analysis",
        "test:unit": "phpunit --colors=always --group=unit --coverage-clover=build/phpunit/clover.xml --coverage-html=build/phpunit/html"
    },
    "scripts-descriptions": {
        "cs:check": "Checks for coding style violations",
        "cs:fix": "Fixes coding style violations",
        "phpstan:baseline": "Runs PHPStan and dumps resulting errors to baseline",
        "phpstan:check": "Runs PHPStan with identifiers support",
        "test:all": "Runs all tests",
        "test:stan": "Runs the Static Analysis Tests",
        "test:unit": "Runs the Unit Tests"
    }
}
